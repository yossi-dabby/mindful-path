+// ─── Wave 2E — Hebrew hopelessness with negation resistance ───────────────────
+//
+// Hebrew patterns for hopelessness require negation awareness because "לא"
+// (not) immediately before a hopelessness phrase inverts its meaning.
+// Example: "אני לא מרגיש חסר תקווה" must NOT trigger hopelessness detection.
+//
+// This helper checks for Hebrew hopelessness patterns and, for "חסר תקווה",
+// verifies that "לא" does not appear within 20 characters before the phrase.
+// All other hopelessness patterns (e.g. "אין תקווה") are direct negations
+// themselves and do not need a secondary negation guard.
+//
+// @private
+// @param {string} text
+// @returns {boolean}
+function _hebrewHopelessnessPresent(text) {
+  try {
+    // "אין תקווה" / "אין שום תקווה" — "there is no hope" (negation already embedded)
+    if (/אין\s+(?:שום\s+)?תקווה/.test(text)) return true;
+    // "שום דבר לא ישתפר" — "nothing will improve"
+    if (/שום\s+דבר\s+לא\s+ישתפר/.test(text)) return true;
+    // "כלום לא ישתנה/ישתפר" — "nothing will change/improve"
+    if (/כלום\s+לא\s+(?:ישתנה|ישתפר)/.test(text)) return true;
+    // "חסר תקווה" — "hopeless" — but NOT when preceded by "לא" within 20 chars
+    const m = text.match(/חסר\s*תקווה/);
+    if (m && typeof m.index === 'number') {
+      const windowBefore = text.slice(Math.max(0, m.index - 20), m.index);
+      if (!windowBefore.includes('לא')) return true;
+    }
+    return false;
+  } catch (_e) {
+    return false;
+  }
+}
